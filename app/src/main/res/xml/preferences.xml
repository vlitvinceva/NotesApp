<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Уведомления">
        <SwitchPreferenceCompat
            app:key="notifications_enabled"
            app:title="Включить уведомления"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="sound_enabled"
            app:title="Звук"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="О приложении">
        <ru.notesapp.ui.AboutPreference
            app:key="about"
            app:title="О приложении" />/>
    </PreferenceCategory>

</PreferenceScreen>